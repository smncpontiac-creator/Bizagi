<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Buzines_Lean"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:collaboration id="Collaboration_BuzinesLean">
    <bpmn:participant id="Participant_Cliente" name="CLIENTE" processRef="Process_Cliente"/>
    <bpmn:participant id="Participant_Ventas" name="VENTAS" processRef="Process_Ventas"/>
    <bpmn:participant id="Participant_Admin" name="ADMINISTRACIÓN" processRef="Process_Admin"/>
    <bpmn:participant id="Participant_Diseno" name="DISEÑO Y BORDADO" processRef="Process_Diseno"/>
    <bpmn:participant id="Participant_Produccion" name="PRODUCCIÓN" processRef="Process_Produccion"/>
    <bpmn:participant id="Participant_Bodega" name="BODEGA Y LOGÍSTICA" processRef="Process_Bodega"/>

    <!-- Message Flows entre participantes -->
    <bpmn:messageFlow id="MsgFlow_01" sourceRef="Start_SolicitudPedido" targetRef="Task_RecibirSolicitud"/>
    <bpmn:messageFlow id="MsgFlow_02" sourceRef="Task_EnviarCotizacion" targetRef="Task_RecibirCotizacion"/>
    <bpmn:messageFlow id="MsgFlow_03" sourceRef="Task_AprobarDiseno" targetRef="Task_RecibirAprobacion"/>
    <bpmn:messageFlow id="MsgFlow_04" sourceRef="Task_SolicitarDiseno" targetRef="Task_DesarrollarDiseno"/>
    <bpmn:messageFlow id="MsgFlow_05" sourceRef="Task_DesarrollarDiseno" targetRef="Task_AprobarDiseno"/>
    <bpmn:messageFlow id="MsgFlow_06" sourceRef="Task_PagoInicial" targetRef="Task_RegistrarPago"/>
    <bpmn:messageFlow id="MsgFlow_07" sourceRef="Task_OrdenProduccion" targetRef="Task_ElaborarMuestras"/>
    <bpmn:messageFlow id="MsgFlow_08" sourceRef="Task_ElaborarMuestras" targetRef="Task_AprobarMuestra"/>
    <bpmn:messageFlow id="MsgFlow_09" sourceRef="Task_AprobarMuestra" targetRef="Task_ConfirmarProduccion"/>
    <bpmn:messageFlow id="MsgFlow_10" sourceRef="Task_PagoFinal" targetRef="Task_RegistrarPagoFinal"/>
    <bpmn:messageFlow id="MsgFlow_11" sourceRef="Task_SolicitarMateriales" targetRef="Task_BuscarMateriales"/>
    <bpmn:messageFlow id="MsgFlow_12" sourceRef="Task_PrepararDespacho" targetRef="Task_RecibirProducto"/>

    <!-- Anotaciones Lean -->
    <bpmn:textAnnotation id="Annotation_Lean_Legend">
      <bpmn:text>🔴 MUDA IDENTIFICADA (No agrega valor)
🟡 OPORTUNIDAD DE MEJORA
⏱️ ESPERA (Waiting)
🚚 TRANSPORTE INNECESARIO
🔄 REPROCESO POTENCIAL
📦 INVENTARIO EXCESIVO
🏃 MOVIMIENTO INNECESARIO</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>

  <!-- ========================================== -->
  <!-- PROCESO CLIENTE                            -->
  <!-- ========================================== -->
  <bpmn:process id="Process_Cliente" name="Cliente">
    <bpmn:startEvent id="Start_SolicitudPedido" name="Enviar solicitud pedido">
      <bpmn:outgoing>Flow_C01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_RecibirCotizacion" name="Recibir y revisar cotización">
      <bpmn:incoming>Flow_C01</bpmn:incoming>
      <bpmn:outgoing>Flow_C02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AprobarDiseno" name="Revisar y aprobar diseño propuesto">
      <bpmn:incoming>Flow_C02</bpmn:incoming>
      <bpmn:outgoing>Flow_C03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PagoInicial" name="Realizar pago inicial 50%">
      <bpmn:incoming>Flow_C03</bpmn:incoming>
      <bpmn:outgoing>Flow_C04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AprobarMuestra" name="Aprobar muestra física">
      <bpmn:incoming>Flow_C04</bpmn:incoming>
      <bpmn:outgoing>Flow_C05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PagoFinal" name="Realizar pago final 50%">
      <bpmn:incoming>Flow_C05</bpmn:incoming>
      <bpmn:outgoing>Flow_C06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RecibirProducto" name="Recibir producto y firmar conformidad">
      <bpmn:incoming>Flow_C06</bpmn:incoming>
      <bpmn:outgoing>Flow_C07</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_ClienteSatisfecho" name="Cliente satisfecho">
      <bpmn:incoming>Flow_C07</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Anotaciones del Proceso Cliente -->
    <bpmn:textAnnotation id="Annotation_Muda1">
      <bpmn:text>⏱️ ESPERA - Cliente toma 3-7 días en aprobar (sin criterios claros)
🟡 MEJORA: Definir criterios aceptación objetivos, checklist validación</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="Annotation_Muda2">
      <bpmn:text>⏱️ ESPERA - Proceso muestra 5-10 días + aprobación cliente 2-5 días
🔄 REPROCESO - 30% muestras requieren ajustes (sin specs claras)
🟡 MEJORA: Specs técnicas detalladas desde diseño, reduce iteraciones</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:association id="Association_Muda1" sourceRef="Annotation_Muda1" targetRef="Task_AprobarDiseno"/>
    <bpmn:association id="Association_Muda2" sourceRef="Annotation_Muda2" targetRef="Task_AprobarMuestra"/>

    <bpmn:sequenceFlow id="Flow_C01" sourceRef="Start_SolicitudPedido" targetRef="Task_RecibirCotizacion"/>
    <bpmn:sequenceFlow id="Flow_C02" sourceRef="Task_RecibirCotizacion" targetRef="Task_AprobarDiseno"/>
    <bpmn:sequenceFlow id="Flow_C03" sourceRef="Task_AprobarDiseno" targetRef="Task_PagoInicial"/>
    <bpmn:sequenceFlow id="Flow_C04" sourceRef="Task_PagoInicial" targetRef="Task_AprobarMuestra"/>
    <bpmn:sequenceFlow id="Flow_C05" sourceRef="Task_AprobarMuestra" targetRef="Task_PagoFinal"/>
    <bpmn:sequenceFlow id="Flow_C06" sourceRef="Task_PagoFinal" targetRef="Task_RecibirProducto"/>
    <bpmn:sequenceFlow id="Flow_C07" sourceRef="Task_RecibirProducto" targetRef="End_ClienteSatisfecho"/>
  </bpmn:process>

  <!-- ========================================== -->
  <!-- PROCESO VENTAS                             -->
  <!-- ========================================== -->
  <bpmn:process id="Process_Ventas" name="Ventas">
    <bpmn:task id="Task_RecibirSolicitud" name="Recibir solicitud cliente">
      <bpmn:outgoing>Flow_V01</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepararCotizacion" name="Preparar cotización">
      <bpmn:incoming>Flow_V01</bpmn:incoming>
      <bpmn:outgoing>Flow_V02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnviarCotizacion" name="Enviar cotización a cliente">
      <bpmn:incoming>Flow_V02</bpmn:incoming>
      <bpmn:outgoing>Flow_V03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SolicitarDiseno" name="Solicitar diseño">
      <bpmn:incoming>Flow_V03</bpmn:incoming>
      <bpmn:outgoing>Flow_V04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RecibirAprobacion" name="Recibir aprobación cliente">
      <bpmn:incoming>Flow_V04</bpmn:incoming>
      <bpmn:outgoing>Flow_V05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CoordinarProduccion" name="Coordinar con producción">
      <bpmn:incoming>Flow_V05</bpmn:incoming>
    </bpmn:task>

    <bpmn:sequenceFlow id="Flow_V01" sourceRef="Task_RecibirSolicitud" targetRef="Task_PrepararCotizacion"/>
    <bpmn:sequenceFlow id="Flow_V02" sourceRef="Task_PrepararCotizacion" targetRef="Task_EnviarCotizacion"/>
    <bpmn:sequenceFlow id="Flow_V03" sourceRef="Task_EnviarCotizacion" targetRef="Task_SolicitarDiseno"/>
    <bpmn:sequenceFlow id="Flow_V04" sourceRef="Task_SolicitarDiseno" targetRef="Task_RecibirAprobacion"/>
    <bpmn:sequenceFlow id="Flow_V05" sourceRef="Task_RecibirAprobacion" targetRef="Task_CoordinarProduccion"/>
  </bpmn:process>

  <!-- ========================================== -->
  <!-- PROCESO ADMINISTRACIÓN                     -->
  <!-- ========================================== -->
  <bpmn:process id="Process_Admin" name="Administración">
    <bpmn:task id="Task_RegistrarPago" name="Registrar pago inicial">
      <bpmn:outgoing>Flow_A01</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_IngresarERPDtemite" name="Ingresar pedido a producción ERP Dtemite">
      <bpmn:incoming>Flow_A01</bpmn:incoming>
      <bpmn:outgoing>Flow_A02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OrdenProduccion" name="Generar orden de producción">
      <bpmn:incoming>Flow_A02</bpmn:incoming>
      <bpmn:outgoing>Flow_A03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ConfirmarProduccion" name="Confirmar producción serie">
      <bpmn:incoming>Flow_A03</bpmn:incoming>
      <bpmn:outgoing>Flow_A04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RegistrarPagoFinal" name="Registrar pago final">
      <bpmn:incoming>Flow_A04</bpmn:incoming>
      <bpmn:outgoing>Flow_A05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AutorizarDespacho" name="Autorizar despacho">
      <bpmn:incoming>Flow_A05</bpmn:incoming>
    </bpmn:task>

    <bpmn:textAnnotation id="Annotation_Muda12">
      <bpmn:text>🔴 SOBREPROCESAMIENTO - Captura datos en ERP + Excel + Papel (triplicado)
⏱️ Tiempo administrativo sin valor agregado
🟡 MEJORA: Integración ERP-WMS elimina captura múltiple</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:association id="Association_Muda12" sourceRef="Annotation_Muda12" targetRef="Task_IngresarERPDtemite"/>

    <bpmn:sequenceFlow id="Flow_A01" sourceRef="Task_RegistrarPago" targetRef="Task_IngresarERPDtemite"/>
    <bpmn:sequenceFlow id="Flow_A02" sourceRef="Task_IngresarERPDtemite" targetRef="Task_OrdenProduccion"/>
    <bpmn:sequenceFlow id="Flow_A03" sourceRef="Task_OrdenProduccion" targetRef="Task_ConfirmarProduccion"/>
    <bpmn:sequenceFlow id="Flow_A04" sourceRef="Task_ConfirmarProduccion" targetRef="Task_RegistrarPagoFinal"/>
    <bpmn:sequenceFlow id="Flow_A05" sourceRef="Task_RegistrarPagoFinal" targetRef="Task_AutorizarDespacho"/>
  </bpmn:process>

  <!-- ========================================== -->
  <!-- PROCESO DISEÑO                             -->
  <!-- ========================================== -->
  <bpmn:process id="Process_Diseno" name="Diseño y Bordado">
    <bpmn:task id="Task_DesarrollarDiseno" name="Desarrollar propuestas diseño">
      <bpmn:outgoing>Flow_D01</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepararArchivos" name="Preparar archivos digitales">
      <bpmn:incoming>Flow_D01</bpmn:incoming>
      <bpmn:outgoing>Flow_D02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ProgramarBordado" name="Programar máquina bordado">
      <bpmn:incoming>Flow_D02</bpmn:incoming>
    </bpmn:task>

    <bpmn:textAnnotation id="Annotation_Muda11">
      <bpmn:text>⏱️ ESPERA - Espera referencias cliente (clientes nuevos)
🔄 REPROCESO - Iteraciones múltiples por falta brief detallado inicial
🟡 MEJORA: Template brief cliente estructurado, banco referencias estándar</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:association id="Association_Muda11" sourceRef="Annotation_Muda11" targetRef="Task_DesarrollarDiseno"/>

    <bpmn:sequenceFlow id="Flow_D01" sourceRef="Task_DesarrollarDiseno" targetRef="Task_PrepararArchivos"/>
    <bpmn:sequenceFlow id="Flow_D02" sourceRef="Task_PrepararArchivos" targetRef="Task_ProgramarBordado"/>
  </bpmn:process>

  <!-- ========================================== -->
  <!-- PROCESO PRODUCCIÓN                         -->
  <!-- ========================================== -->
  <bpmn:process id="Process_Produccion" name="Producción">
    <bpmn:task id="Task_SolicitarMateriales" name="Solicitar materiales a bodega">
      <bpmn:outgoing>Flow_P01</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RecibirMateriales" name="Recibir materiales">
      <bpmn:incoming>Flow_P01</bpmn:incoming>
      <bpmn:outgoing>Flow_P02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ElaborarMuestras" name="Elaborar muestras físicas">
      <bpmn:incoming>Flow_P02</bpmn:incoming>
      <bpmn:outgoing>Flow_P03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Confeccionar" name="Confeccionar prendas en serie">
      <bpmn:incoming>Flow_P03</bpmn:incoming>
      <bpmn:outgoing>Flow_P04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ControlCalidad" name="Control de calidad confección">
      <bpmn:incoming>Flow_P04</bpmn:incoming>
      <bpmn:outgoing>Flow_P05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmpaquetarProducto" name="Empaquetar producto terminado">
      <bpmn:incoming>Flow_P05</bpmn:incoming>
      <bpmn:outgoing>Flow_P06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EnviarBodega" name="Enviar a bodega">
      <bpmn:incoming>Flow_P06</bpmn:incoming>
    </bpmn:task>

    <bpmn:textAnnotation id="Annotation_Muda8">
      <bpmn:text>🔄 REPROCESO - 30% muestras requieren ajustes por specs poco claras
⏱️ ESPERA - Espera materiales de bodega 15-30 min
🟡 MEJORA: Specs técnicas claras, kit materiales pre-preparado</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="Annotation_Muda9">
      <bpmn:text>🏃 MOVIMIENTO INNECESARIO - Layout no optimizado, herramientas lejos
⏱️ ESPERA - Espera materiales, espera máquinas disponibles
🔄 REPROCESO - Tasa defectos 3-5% por ausencia SOP y Poka-Yoke
🟡 MEJORA: Células manufactura, 5S, SOP con fotos, Poka-Yoke puntos críticos</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="Annotation_Muda10">
      <bpmn:text>🔴 SOBREPROCESAMIENTO - Inspecciones redundantes sin criterios claros
📝 Mismo producto inspeccionado múltiples veces por diferentes personas
🟡 MEJORA: Inspección en la fuente (Jidoka), checklist objetivo, roles RACI claros</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:association id="Association_Muda8" sourceRef="Annotation_Muda8" targetRef="Task_ElaborarMuestras"/>
    <bpmn:association id="Association_Muda9" sourceRef="Annotation_Muda9" targetRef="Task_Confeccionar"/>
    <bpmn:association id="Association_Muda10" sourceRef="Annotation_Muda10" targetRef="Task_ControlCalidad"/>

    <bpmn:sequenceFlow id="Flow_P01" sourceRef="Task_SolicitarMateriales" targetRef="Task_RecibirMateriales"/>
    <bpmn:sequenceFlow id="Flow_P02" sourceRef="Task_RecibirMateriales" targetRef="Task_ElaborarMuestras"/>
    <bpmn:sequenceFlow id="Flow_P03" sourceRef="Task_ElaborarMuestras" targetRef="Task_Confeccionar"/>
    <bpmn:sequenceFlow id="Flow_P04" sourceRef="Task_Confeccionar" targetRef="Task_ControlCalidad"/>
    <bpmn:sequenceFlow id="Flow_P05" sourceRef="Task_ControlCalidad" targetRef="Task_EmpaquetarProducto"/>
    <bpmn:sequenceFlow id="Flow_P06" sourceRef="Task_EmpaquetarProducto" targetRef="Task_EnviarBodega"/>
  </bpmn:process>

  <!-- ========================================== -->
  <!-- PROCESO BODEGA                             -->
  <!-- ========================================== -->
  <bpmn:process id="Process_Bodega" name="Bodega y Logística">
    <bpmn:task id="Task_BuscarMateriales" name="Buscar materiales en bodega">
      <bpmn:outgoing>Flow_B01</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TransporteBodegaCasaMatriz" name="Transportar materiales bodega → casa matriz">
      <bpmn:incoming>Flow_B01</bpmn:incoming>
      <bpmn:outgoing>Flow_B02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ControlInventarioManual" name="Actualizar Excel control inventarios">
      <bpmn:incoming>Flow_B02</bpmn:incoming>
      <bpmn:outgoing>Flow_B03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EntregarMateriales" name="Entregar materiales a producción">
      <bpmn:incoming>Flow_B03</bpmn:incoming>
      <bpmn:outgoing>Flow_B04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RecibirProductoTerminado" name="Recibir producto terminado">
      <bpmn:incoming>Flow_B04</bpmn:incoming>
      <bpmn:outgoing>Flow_B05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InventarioExcesivo" name="Almacenar inventario clase C (baja rotación)">
      <bpmn:incoming>Flow_B05</bpmn:incoming>
      <bpmn:outgoing>Flow_B06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepararDespacho" name="Preparar pedido para despacho">
      <bpmn:incoming>Flow_B06</bpmn:incoming>
    </bpmn:task>

    <bpmn:textAnnotation id="Annotation_Muda3">
      <bpmn:text>🔴 MUDA CRÍTICA - Búsqueda manual 15-30 min/operario/día
🏃 MOVIMIENTO INNECESARIO - Sin ubicaciones definidas, recorridos largos
⏱️ ESPERA - Producción parada esperando materiales
🟡 MEJORA: WMS con ubicaciones específicas, código barras, señalización 5S</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="Annotation_Muda4">
      <bpmn:text>🔴 MUDA CRÍTICA - Transporte innecesario
🚚 2-3 viajes diarios × 30 km × 60 min = 660 horas/año perdidas
💰 Costo: $6.6M/año (tiempo + combustible + desgaste + riesgo)
🟡 MEJORA: Consolidación instalaciones o WMS multi-sitio con milk run optimizado</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="Annotation_Muda5">
      <bpmn:text>🔴 MUDA - Sobreprocesamiento manual
📝 Captura datos manual Excel = errores 15-25%
⏱️ Tiempo consumido sin valor agregado
🔄 Reproceso cuando hay discrepancias con físico
🟡 MEJORA: WMS automatiza captura tiempo real, elimina Excel manual</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="Annotation_Muda6">
      <bpmn:text>🔴 MUDA - Inventario excesivo
📦 $15-30M capital inmovilizado en materiales baja rotación (&lt;2x/año)
💰 Costo oportunidad 8% = $1.2-2.4M/año
🏢 Espacio bodega ocupado innecesariamente
🟡 MEJORA: Clasificación ABC rigurosa, Kanban clase A, liquidación clase C</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:textAnnotation id="Annotation_Muda7">
      <bpmn:text>⏱️ ESPERA - Coordinación telefónica/WhatsApp reactiva
🏃 MOVIMIENTO - Picking sin ruta optimizada
🟡 MEJORA: Sistema picking optimizado, wave picking, rutas definidas</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:association id="Association_Muda3" sourceRef="Annotation_Muda3" targetRef="Task_BuscarMateriales"/>
    <bpmn:association id="Association_Muda4" sourceRef="Annotation_Muda4" targetRef="Task_TransporteBodegaCasaMatriz"/>
    <bpmn:association id="Association_Muda5" sourceRef="Annotation_Muda5" targetRef="Task_ControlInventarioManual"/>
    <bpmn:association id="Association_Muda6" sourceRef="Annotation_Muda6" targetRef="Task_InventarioExcesivo"/>
    <bpmn:association id="Association_Muda7" sourceRef="Annotation_Muda7" targetRef="Task_PrepararDespacho"/>

    <bpmn:sequenceFlow id="Flow_B01" sourceRef="Task_BuscarMateriales" targetRef="Task_TransporteBodegaCasaMatriz"/>
    <bpmn:sequenceFlow id="Flow_B02" sourceRef="Task_TransporteBodegaCasaMatriz" targetRef="Task_ControlInventarioManual"/>
    <bpmn:sequenceFlow id="Flow_B03" sourceRef="Task_ControlInventarioManual" targetRef="Task_EntregarMateriales"/>
    <bpmn:sequenceFlow id="Flow_B04" sourceRef="Task_EntregarMateriales" targetRef="Task_RecibirProductoTerminado"/>
    <bpmn:sequenceFlow id="Flow_B05" sourceRef="Task_RecibirProductoTerminado" targetRef="Task_InventarioExcesivo"/>
    <bpmn:sequenceFlow id="Flow_B06" sourceRef="Task_InventarioExcesivo" targetRef="Task_PrepararDespacho"/>
  </bpmn:process>

  <!-- ============================================ -->
  <!-- DIAGRAMA VISUAL CON COORDENADAS             -->
  <!-- ============================================ -->

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_BuzinesLean">

      <!-- ============================================ -->
      <!-- POOLS DE PARTICIPANTES                       -->
      <!-- ============================================ -->

      <bpmndi:BPMNShape id="Shape_Participant_Cliente" bpmnElement="Participant_Cliente" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2400" height="350"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_Ventas" bpmnElement="Participant_Ventas" isHorizontal="true">
        <dc:Bounds x="160" y="450" width="2400" height="200"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_Admin" bpmnElement="Participant_Admin" isHorizontal="true">
        <dc:Bounds x="160" y="670" width="2400" height="250"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Participant_Diseno" bpmnElement="Participant_Diseno" isHorizontal="true">
        <dc:Bounds x="160" y="940" width="2400" height="200"/>
      </bpmndi:BPMNShape>

