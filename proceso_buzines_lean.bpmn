<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
             targetNamespace="http://www.omg.org/bpmn20"
             id="Definitions_Buzines_Final">

  <collaboration id="Collaboration_Buzines">
    <participant id="Participant_Cliente" name="CLIENTE" processRef="Process_Cliente"/>
    <participant id="Participant_Ventas" name="VENTAS" processRef="Process_Ventas"/>
    <participant id="Participant_Admin" name="ADMINISTRACION" processRef="Process_Admin"/>
    <participant id="Participant_Diseno" name="DISENO Y BORDADO" processRef="Process_Diseno"/>
    <participant id="Participant_Produccion" name="PRODUCCION" processRef="Process_Produccion"/>
    <participant id="Participant_Bodega" name="BODEGA Y LOGISTICA" processRef="Process_Bodega"/>

    <!-- =========== MESSAGE FLOWS COMPLETOS =========== -->
    <!-- 1. Cliente → Ventas: Solicitud -->
    <messageFlow id="MsgFlow_01" sourceRef="Event_Start" targetRef="Task_RecibirSolicitud" name="Solicitud pedido"/>

    <!-- 2. Ventas → Cliente: Cotización -->
    <messageFlow id="MsgFlow_02" sourceRef="Task_EnviarCotizacion" targetRef="Task_RecibirCotizacion" name="Cotizacion PDF"/>

    <!-- 3. Ventas → Diseño: Solicitud de diseño -->
    <messageFlow id="MsgFlow_03" sourceRef="Task_SolicitarReferencias" targetRef="Task_DesarrollarDiseno" name="Brief diseño"/>

    <!-- 4. Diseño → Cliente: Diseño propuesto -->
    <messageFlow id="MsgFlow_04" sourceRef="Task_ControlCalidadDiseno" targetRef="Task_AprobarDiseno" name="Propuesta diseño"/>

    <!-- 5. Cliente → Ventas: Aprobación diseño -->
    <messageFlow id="MsgFlow_05" sourceRef="Task_AprobarDiseno" targetRef="Gateway_ClienteNuevo" name="Aprobacion"/>

    <!-- 6. Cliente → Admin: Pago inicial -->
    <messageFlow id="MsgFlow_06" sourceRef="Task_PagoInicial" targetRef="Task_ProcesarOC" name="Pago 50%"/>

    <!-- 7. Admin → Producción: Orden de producción -->
    <messageFlow id="MsgFlow_07" sourceRef="Task_IngresarERP" targetRef="Task_ElaborarMuestras" name="Orden produccion"/>

    <!-- 8. Producción → Bodega: Solicitud materiales -->
    <messageFlow id="MsgFlow_08" sourceRef="Task_ElaborarMuestras" targetRef="Task_BuscarMateriales" name="Requerimiento materiales"/>

    <!-- 9. Bodega → Producción: Entrega materiales -->
    <messageFlow id="MsgFlow_09" sourceRef="Task_TransportarMateriales" targetRef="Task_AjustarMuestras" name="Materiales"/>

    <!-- 10. Producción → Cliente: Muestra física -->
    <messageFlow id="MsgFlow_10" sourceRef="Task_AjustarMuestras" targetRef="Task_AprobarMuestra" name="Muestra fisica"/>

    <!-- 11. Cliente → Admin: Aprobación muestra -->
    <messageFlow id="MsgFlow_11" sourceRef="Task_AprobarMuestra" targetRef="Task_SolicitarPagoFinal" name="Aprobacion muestra"/>

    <!-- 12. Cliente → Admin: Pago final -->
    <messageFlow id="MsgFlow_12" sourceRef="Task_PagoFinal" targetRef="Task_GenerarFacturas" name="Pago 50%"/>

    <!-- 13. Producción → Bodega: Producto terminado -->
    <messageFlow id="MsgFlow_13" sourceRef="Task_ControlCalidadProduccion" targetRef="Task_AlmacenarInventario" name="Producto terminado"/>

    <!-- 14. Bodega → Cliente: Entrega final -->
    <messageFlow id="MsgFlow_14" sourceRef="Task_CoordinarEntrega" targetRef="Task_RecibirProducto" name="Notificacion entrega"/>

    <!-- =========== ANOTACIONES GLOBALES =========== -->
    <textAnnotation id="Annotation_Leyenda">
      <text>LEYENDA LEAN MANUFACTURING:
🔴 ROJO = MUDA CRITICA (impacto mayor a 2M pesos/año)
🟡 AMARILLO = OPORTUNIDAD DE MEJORA

SIMBOLOS:
⏱️ = ESPERA (Waiting)
🚚 = TRANSPORTE INNECESARIO
🔄 = REPROCESO
📦 = INVENTARIO EXCESIVO
🏃 = MOVIMIENTO INNECESARIO
📝 = SOBREPROCESAMIENTO

TIPOS DE TAREA:
👤 = Tarea de Usuario    ✋ = Tarea Manual
⚙️ = Tarea de Servicio   📄 = Tarea de Script</text>
    </textAnnotation>

    <textAnnotation id="Annotation_Resumen">
      <text>RESUMEN IMPACTO ECONOMICO MUDAS:
🔴 MUDAS CRITICAS (6):
  M4: Transporte innecesario ........ $6.6M/año
  M9: Defectos confeccion ....... $5.5-8.5M/año
  M3: Busqueda materiales ..... $2.75-3.62M/año
  M10: Control calidad .............. $2-4M/año
  M12: Captura triplicada ........... $1-2M/año
  M5: Excel inventarios ...... $800K-1.2M/año
  SUBTOTAL: .............. $18.65-26.92M/año

🟡 OPORTUNIDADES MEJORA (6): ..... $6-12M/año

💰 AHORRO POTENCIAL TOTAL: ..... $24-38M/año
📊 Ahorro conservador 70%: ....... $16.8-26.6M/año</text>
    </textAnnotation>
  </collaboration>

  <!-- ==================== PROCESO CLIENTE ==================== -->
  <process id="Process_Cliente" name="Cliente" isExecutable="false">
    <laneSet id="LaneSet_Cliente">
      <lane id="Lane_Cliente" name="Cliente">
        <flowNodeRef>Event_Start</flowNodeRef>
        <flowNodeRef>Task_RecibirCotizacion</flowNodeRef>
        <flowNodeRef>Task_AprobarDiseno</flowNodeRef>
        <flowNodeRef>Task_PagoInicial</flowNodeRef>
        <flowNodeRef>Task_AprobarMuestra</flowNodeRef>
        <flowNodeRef>Task_PagoFinal</flowNodeRef>
        <flowNodeRef>Task_RecibirProducto</flowNodeRef>
        <flowNodeRef>Event_End</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="Event_Start" name="Enviar solicitud pedido">
      <outgoing>Flow_C01</outgoing>
    </startEvent>

    <userTask id="Task_RecibirCotizacion" name="Recibir y revisar cotizacion">
      <incoming>Flow_C01</incoming>
      <outgoing>Flow_C02</outgoing>
    </userTask>

    <userTask id="Task_AprobarDiseno" name="Revisar y aprobar diseno propuesto">
      <incoming>Flow_C02</incoming>
      <outgoing>Flow_C03</outgoing>
    </userTask>

    <task id="Task_PagoInicial" name="Realizar pago inicial 50%">
      <incoming>Flow_C03</incoming>
      <outgoing>Flow_C04</outgoing>
    </task>

    <userTask id="Task_AprobarMuestra" name="Aprobar muestra fisica">
      <incoming>Flow_C04</incoming>
      <outgoing>Flow_C05</outgoing>
    </userTask>

    <task id="Task_PagoFinal" name="Realizar pago final 50%">
      <incoming>Flow_C05</incoming>
      <outgoing>Flow_C06</outgoing>
    </task>

    <userTask id="Task_RecibirProducto" name="Recibir producto y firmar conformidad">
      <incoming>Flow_C06</incoming>
      <outgoing>Flow_C07</outgoing>
    </userTask>

    <endEvent id="Event_End" name="Cliente satisfecho">
      <incoming>Flow_C07</incoming>
    </endEvent>

    <sequenceFlow id="Flow_C01" sourceRef="Event_Start" targetRef="Task_RecibirCotizacion"/>
    <sequenceFlow id="Flow_C02" sourceRef="Task_RecibirCotizacion" targetRef="Task_AprobarDiseno"/>
    <sequenceFlow id="Flow_C03" sourceRef="Task_AprobarDiseno" targetRef="Task_PagoInicial"/>
    <sequenceFlow id="Flow_C04" sourceRef="Task_PagoInicial" targetRef="Task_AprobarMuestra"/>
    <sequenceFlow id="Flow_C05" sourceRef="Task_AprobarMuestra" targetRef="Task_PagoFinal"/>
    <sequenceFlow id="Flow_C06" sourceRef="Task_PagoFinal" targetRef="Task_RecibirProducto"/>
    <sequenceFlow id="Flow_C07" sourceRef="Task_RecibirProducto" targetRef="Event_End"/>

    <textAnnotation id="Annotation_M1">
      <text>M1 - MUDA ESPERA
⏱️ Cliente 3-7 días aprobar (sin criterios)
🟡 MEJORA: Criterios objetivos + checklist
💰 Impacto: Retraso 3-7 días</text>
    </textAnnotation>
    <association id="Assoc_M1" sourceRef="Task_AprobarDiseno" targetRef="Annotation_M1"/>

    <textAnnotation id="Annotation_M2">
      <text>M2 - MUDA ESPERA + REPROCESO
⏱️ Proceso 5-10 días + aprobación 2-5 días
🔄 30% muestras requieren ajustes
🟡 MEJORA: Specs técnicas detalladas
💰 IMPACTO: $2-4M/año</text>
    </textAnnotation>
    <association id="Assoc_M2" sourceRef="Task_AprobarMuestra" targetRef="Annotation_M2"/>
  </process>

  <!-- ==================== PROCESO VENTAS ==================== -->
  <process id="Process_Ventas" name="Ventas" isExecutable="false">
    <laneSet id="LaneSet_Ventas">
      <lane id="Lane_Ventas" name="Ventas">
        <flowNodeRef>Task_RecibirSolicitud</flowNodeRef>
        <flowNodeRef>Task_EnviarCotizacion</flowNodeRef>
        <flowNodeRef>Gateway_ClienteNuevo</flowNodeRef>
        <flowNodeRef>Task_SolicitarReferencias</flowNodeRef>
        <flowNodeRef>Task_CrearFichaTecnica</flowNodeRef>
        <flowNodeRef>Task_SinReferencias</flowNodeRef>
        <flowNodeRef>Gateway_Merge</flowNodeRef>
      </lane>
    </laneSet>

    <task id="Task_RecibirSolicitud" name="Recibir solicitud cliente">
      <outgoing>Flow_V01</outgoing>
    </task>

    <serviceTask id="Task_EnviarCotizacion" name="Enviar cotizacion formal con plazos">
      <incoming>Flow_V01</incoming>
      <outgoing>Flow_V02</outgoing>
    </serviceTask>

    <exclusiveGateway id="Gateway_ClienteNuevo" name="Cliente nuevo?">
      <incoming>Flow_V02</incoming>
      <outgoing>Flow_V03</outgoing>
      <outgoing>Flow_V04</outgoing>
    </exclusiveGateway>

    <userTask id="Task_SolicitarReferencias" name="Solicitar referencias de diseno">
      <incoming>Flow_V03</incoming>
      <outgoing>Flow_V05</outgoing>
    </userTask>

    <userTask id="Task_CrearFichaTecnica" name="Crear ficha tecnica cliente">
      <incoming>Flow_V05</incoming>
      <outgoing>Flow_V06</outgoing>
    </userTask>

    <task id="Task_SinReferencias" name="Continuar sin referencias">
      <incoming>Flow_V04</incoming>
      <outgoing>Flow_V07</outgoing>
    </task>

    <exclusiveGateway id="Gateway_Merge">
      <incoming>Flow_V06</incoming>
      <incoming>Flow_V07</incoming>
    </exclusiveGateway>

    <sequenceFlow id="Flow_V01" sourceRef="Task_RecibirSolicitud" targetRef="Task_EnviarCotizacion"/>
    <sequenceFlow id="Flow_V02" sourceRef="Task_EnviarCotizacion" targetRef="Gateway_ClienteNuevo"/>
    <sequenceFlow id="Flow_V03" name="SI" sourceRef="Gateway_ClienteNuevo" targetRef="Task_SolicitarReferencias"/>
    <sequenceFlow id="Flow_V04" name="NO" sourceRef="Gateway_ClienteNuevo" targetRef="Task_SinReferencias"/>
    <sequenceFlow id="Flow_V05" sourceRef="Task_SolicitarReferencias" targetRef="Task_CrearFichaTecnica"/>
    <sequenceFlow id="Flow_V06" sourceRef="Task_CrearFichaTecnica" targetRef="Gateway_Merge"/>
    <sequenceFlow id="Flow_V07" sourceRef="Task_SinReferencias" targetRef="Gateway_Merge"/>
  </process>

  <!-- ==================== PROCESO ADMINISTRACION ==================== -->
  <process id="Process_Admin" name="Administracion" isExecutable="false">
    <laneSet id="LaneSet_Admin">
      <lane id="Lane_Admin" name="Administracion">
        <flowNodeRef>Task_ProcesarOC</flowNodeRef>
        <flowNodeRef>Task_IngresarERP</flowNodeRef>
        <flowNodeRef>Task_SolicitarPagoFinal</flowNodeRef>
        <flowNodeRef>Task_GenerarFacturas</flowNodeRef>
      </lane>
    </laneSet>

    <scriptTask id="Task_ProcesarOC" name="Procesar orden de compra">
      <outgoing>Flow_A01</outgoing>
    </scriptTask>

    <serviceTask id="Task_IngresarERP" name="Ingresar pedido ERP Dtemite">
      <incoming>Flow_A01</incoming>
      <outgoing>Flow_A02</outgoing>
    </serviceTask>

    <task id="Task_SolicitarPagoFinal" name="Solicitar pago final 50%">
      <incoming>Flow_A02</incoming>
      <outgoing>Flow_A03</outgoing>
    </task>

    <serviceTask id="Task_GenerarFacturas" name="Generar facturas">
      <incoming>Flow_A03</incoming>
    </serviceTask>

    <sequenceFlow id="Flow_A01" sourceRef="Task_ProcesarOC" targetRef="Task_IngresarERP"/>
    <sequenceFlow id="Flow_A02" sourceRef="Task_IngresarERP" targetRef="Task_SolicitarPagoFinal"/>
    <sequenceFlow id="Flow_A03" sourceRef="Task_SolicitarPagoFinal" targetRef="Task_GenerarFacturas"/>

    <textAnnotation id="Annotation_M12">
      <text>M12 - MUDA CRITICA SOBREPROCESAMIENTO
🔴 Captura triplicada: ERP + Excel + Papel
⏱️ Tiempo sin valor agregado
🟡 MEJORA: Integración ERP-WMS
💰 IMPACTO: $1-2M/año</text>
    </textAnnotation>
    <association id="Assoc_M12" sourceRef="Task_IngresarERP" targetRef="Annotation_M12"/>
  </process>

  <!-- ==================== PROCESO DISEÑO ==================== -->
  <process id="Process_Diseno" name="Diseno y Bordado" isExecutable="false">
    <laneSet id="LaneSet_Diseno">
      <lane id="Lane_Diseno" name="Diseno y Bordado">
        <flowNodeRef>Task_DesarrollarDiseno</flowNodeRef>
        <flowNodeRef>Task_DesarrollarArchivos</flowNodeRef>
        <flowNodeRef>Task_ControlCalidadDiseno</flowNodeRef>
      </lane>
    </laneSet>

    <userTask id="Task_DesarrollarDiseno" name="Desarrollar propuestas diseno">
      <outgoing>Flow_D01</outgoing>
    </userTask>

    <task id="Task_DesarrollarArchivos" name="Desarrollar archivos bordado">
      <incoming>Flow_D01</incoming>
      <outgoing>Flow_D02</outgoing>
    </task>

    <manualTask id="Task_ControlCalidadDiseno" name="Control calidad personalizacion">
      <incoming>Flow_D02</incoming>
    </manualTask>

    <sequenceFlow id="Flow_D01" sourceRef="Task_DesarrollarDiseno" targetRef="Task_DesarrollarArchivos"/>
    <sequenceFlow id="Flow_D02" sourceRef="Task_DesarrollarArchivos" targetRef="Task_ControlCalidadDiseno"/>

    <textAnnotation id="Annotation_M11">
      <text>M11 - MUDA ESPERA + REPROCESO
⏱️ Espera referencias cliente
🔄 Iteraciones por falta brief
🟡 MEJORA: Template + banco referencias
💰 Impacto: Retraso 3-5 días</text>
    </textAnnotation>
    <association id="Assoc_M11" sourceRef="Task_DesarrollarDiseno" targetRef="Annotation_M11"/>
  </process>

  <!-- ==================== PROCESO PRODUCCION ==================== -->
  <process id="Process_Produccion" name="Produccion" isExecutable="false">
    <laneSet id="LaneSet_Produccion">
      <lane id="Lane_Produccion" name="Produccion">
        <flowNodeRef>Task_ElaborarMuestras</flowNodeRef>
        <flowNodeRef>Task_AjustarMuestras</flowNodeRef>
        <flowNodeRef>Task_ConfeccionarSerie</flowNodeRef>
        <flowNodeRef>Task_ControlCalidadProduccion</flowNodeRef>
      </lane>
    </laneSet>

    <userTask id="Task_ElaborarMuestras" name="Elaborar muestras fisicas">
      <outgoing>Flow_P01</outgoing>
    </userTask>

    <task id="Task_AjustarMuestras" name="Ajustar y corregir muestras">
      <incoming>Flow_P01</incoming>
      <outgoing>Flow_P02</outgoing>
    </task>

    <userTask id="Task_ConfeccionarSerie" name="Confeccionar prendas en serie">
      <incoming>Flow_P02</incoming>
      <outgoing>Flow_P03</outgoing>
    </userTask>

    <manualTask id="Task_ControlCalidadProduccion" name="Control calidad confeccion">
      <incoming>Flow_P03</incoming>
    </manualTask>

    <sequenceFlow id="Flow_P01" sourceRef="Task_ElaborarMuestras" targetRef="Task_AjustarMuestras"/>
    <sequenceFlow id="Flow_P02" sourceRef="Task_AjustarMuestras" targetRef="Task_ConfeccionarSerie"/>
    <sequenceFlow id="Flow_P03" sourceRef="Task_ConfeccionarSerie" targetRef="Task_ControlCalidadProduccion"/>

    <textAnnotation id="Annotation_M8">
      <text>M8 - MUDA REPROCESO
🔄 30% muestras requieren ajustes
⏱️ Espera materiales 15-30 min
🟡 MEJORA: Specs + kit preparado
💰 IMPACTO: $1.5-2.5M/año</text>
    </textAnnotation>
    <association id="Assoc_M8" sourceRef="Task_ElaborarMuestras" targetRef="Annotation_M8"/>

    <textAnnotation id="Annotation_M9">
      <text>M9 - MUDA CRITICA MULTIPLE
🔴 Layout no optimizado
🏃 MOVIMIENTO innecesario
⏱️ ESPERAS materiales/maquinas
🔄 Defectos 3-5% sin SOP
🟡 MEJORA: Celulas + 5S + Poka-Yoke
💰 IMPACTO: $5.5-8.5M/año</text>
    </textAnnotation>
    <association id="Assoc_M9" sourceRef="Task_ConfeccionarSerie" targetRef="Annotation_M9"/>

    <textAnnotation id="Annotation_M10">
      <text>M10 - MUDA CRITICA SOBREPROCESO
🔴 Inspecciones redundantes
📝 Mismo producto inspeccionado multiples veces
🟡 MEJORA: Jidoka + checklist + RACI
💰 IMPACTO: $2-4M/año</text>
    </textAnnotation>
    <association id="Assoc_M10" sourceRef="Task_ControlCalidadProduccion" targetRef="Annotation_M10"/>
  </process>

  <!-- ==================== PROCESO BODEGA ==================== -->
  <process id="Process_Bodega" name="Bodega y Logistica" isExecutable="false">
    <laneSet id="LaneSet_Bodega">
      <lane id="Lane_Bodega" name="Bodega y Logistica">
        <flowNodeRef>Task_BuscarMateriales</flowNodeRef>
        <flowNodeRef>Task_TransportarMateriales</flowNodeRef>
        <flowNodeRef>Task_ActualizarExcel</flowNodeRef>
        <flowNodeRef>Task_AlmacenarInventario</flowNodeRef>
        <flowNodeRef>Task_PrepararDespacho</flowNodeRef>
        <flowNodeRef>Task_CoordinarEntrega</flowNodeRef>
      </lane>
    </laneSet>

    <manualTask id="Task_BuscarMateriales" name="Buscar materiales en bodega">
      <outgoing>Flow_B01</outgoing>
    </manualTask>

    <manualTask id="Task_TransportarMateriales" name="Transportar materiales bodega a matriz">
      <incoming>Flow_B01</incoming>
      <outgoing>Flow_B02</outgoing>
    </manualTask>

    <scriptTask id="Task_ActualizarExcel" name="Actualizar Excel inventarios">
      <incoming>Flow_B02</incoming>
      <outgoing>Flow_B03</outgoing>
    </scriptTask>

    <task id="Task_AlmacenarInventario" name="Almacenar inventario clase C">
      <incoming>Flow_B03</incoming>
      <outgoing>Flow_B04</outgoing>
    </task>

    <manualTask id="Task_PrepararDespacho" name="Preparar pedido despacho">
      <incoming>Flow_B04</incoming>
      <outgoing>Flow_B05</outgoing>
    </manualTask>

    <task id="Task_CoordinarEntrega" name="Coordinar entrega cliente">
      <incoming>Flow_B05</incoming>
    </task>

    <sequenceFlow id="Flow_B01" sourceRef="Task_BuscarMateriales" targetRef="Task_TransportarMateriales"/>
    <sequenceFlow id="Flow_B02" sourceRef="Task_TransportarMateriales" targetRef="Task_ActualizarExcel"/>
    <sequenceFlow id="Flow_B03" sourceRef="Task_ActualizarExcel" targetRef="Task_AlmacenarInventario"/>
    <sequenceFlow id="Flow_B04" sourceRef="Task_AlmacenarInventario" targetRef="Task_PrepararDespacho"/>
    <sequenceFlow id="Flow_B05" sourceRef="Task_PrepararDespacho" targetRef="Task_CoordinarEntrega"/>

    <textAnnotation id="Annotation_M3">
      <text>M3 - MUDA CRITICA MOVIMIENTO
🔴 Busqueda 15-30 min/operario/dia
🏃 Sin ubicaciones definidas
⏱️ Produccion parada esperando
🟡 MEJORA: WMS + codigo barras + 5S
💰 IMPACTO: $2.75-3.62M/año</text>
    </textAnnotation>
    <association id="Assoc_M3" sourceRef="Task_BuscarMateriales" targetRef="Annotation_M3"/>

    <textAnnotation id="Annotation_M4">
      <text>M4 - MUDA CRITICA TRANSPORTE
🔴 2-3 viajes × 30 km × 60 min
🚚 660 horas/año perdidas
💰 IMPACTO: $6.6M/año
🟡 MEJORA: Consolidacion o WMS multi-sitio
*** MUDA MAS CRITICA ***</text>
    </textAnnotation>
    <association id="Assoc_M4" sourceRef="Task_TransportarMateriales" targetRef="Annotation_M4"/>

    <textAnnotation id="Annotation_M5">
      <text>M5 - MUDA SOBREPROCESAMIENTO
🔴 Captura manual Excel
📝 Errores 15-25%
🔄 Reproceso discrepancias
🟡 MEJORA: WMS automatiza captura
💰 IMPACTO: $800K-1.2M/año</text>
    </textAnnotation>
    <association id="Assoc_M5" sourceRef="Task_ActualizarExcel" targetRef="Annotation_M5"/>

    <textAnnotation id="Annotation_M6">
      <text>M6 - MUDA INVENTARIO EXCESIVO
📦 $15-30M capital inmovilizado
💰 Costo oportunidad $1.2-2.4M/año
🏢 Espacio bodega ocupado
🟡 MEJORA: ABC + Kanban + liquidacion C</text>
    </textAnnotation>
    <association id="Assoc_M6" sourceRef="Task_AlmacenarInventario" targetRef="Annotation_M6"/>

    <textAnnotation id="Annotation_M7">
      <text>M7 - MUDA ESPERA + MOVIMIENTO
⏱️ Coordinacion telefonica reactiva
🏃 Picking sin ruta optimizada
🟡 MEJORA: Sistema picking + wave picking
💰 IMPACTO: $400-700K/año</text>
    </textAnnotation>
    <association id="Assoc_M7" sourceRef="Task_PrepararDespacho" targetRef="Annotation_M7"/>
  </process>

  <!-- ========== BPMNDI: INFORMACION VISUAL ========== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Buzines">

      <!-- LEYENDA (parte superior derecha) -->
      <bpmndi:BPMNShape id="Shape_Leyenda" bpmnElement="Annotation_Leyenda">
        <omgdc:Bounds x="2300" y="50" width="400" height="200"/>
      </bpmndi:BPMNShape>

      <!-- RESUMEN (parte inferior derecha) -->
      <bpmndi:BPMNShape id="Shape_Resumen" bpmnElement="Annotation_Resumen">
        <omgdc:Bounds x="2300" y="1350" width="400" height="200"/>
      </bpmndi:BPMNShape>

      <!-- ============ LANE CLIENTE ============ -->
      <bpmndi:BPMNShape id="Shape_Lane_Cliente" bpmnElement="Participant_Cliente" isHorizontal="true">
        <omgdc:Bounds x="80" y="250" width="2600" height="180"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Event_Start">
        <omgdc:Bounds x="160" y="322" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_RecibirCot" bpmnElement="Task_RecibirCotizacion">
        <omgdc:Bounds x="270" y="300" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_AprobarDis" bpmnElement="Task_AprobarDiseno">
